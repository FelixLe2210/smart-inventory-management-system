# Java / Spring Boot
target/
*.class
*.jar
*.war
*.ear
# NOTE: .mvn/ is intentionally NOT ignored - it holds the Maven Wrapper
# (mvnw/mvnw.cmd + .mvn/wrapper/maven-wrapper.properties), which must be
# committed so anyone cloning the repo can run ./mvnw without installing
# Maven manually.

