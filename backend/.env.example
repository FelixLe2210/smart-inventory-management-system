# Copy this file as .env and adjust to your local environment.
# Uses the current Windows account. The SQL Server JDBC auth DLL must be available to the JVM.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=User_Role_WMS;encrypt=true;trustServerCertificate=true;integratedSecurity=true;authenticationScheme=NativeAuthentication
SERVER_PORT=8080
